{
  "job": "feishu_example",
  "description": "飞书多维表格「示例数据表」→ my_project.ods_example_json_df（json + pt 分区，临时分区 + 原子替换）",

  "feishu": {
    "app_id": "cli_xxxxxxxxxxxxxxxx",
    "app_secret": "<App Secret>",
    "base_token": "IC4xxxxxxxxxxxxxxxxxxxxxxxxx",
    "table_id": "tblexxxxxxxxxxxxxxxx",
    "base_url": "https://xxx.feishu.cn/base/IC4xxxxxxxxxxxxxxxxxxxxxxxxx"
  },

  "maxcompute": {
    "project": "my_project",
    "endpoint": "https://service.us-west-1.maxcompute.aliyun.com/api",
    "access_key_id": "<阿里云 AccessKeyId>",
    "access_key_secret": "<阿里云 AccessKeySecret>"
  },

  "fields": {
    "日期": "biz_date",
    "名称": "col_a",
    "数量": "col_b",
    "金额": "col_c"
  },

  "target": {
    "project": "my_project",
    "table": "ods_example_json_df",
    "column": "json",
    "comment": "示例数据表（飞书多维表格同步，JSON 原样，写临时分区后原子替换 pt=业务日）",
    "allow_empty": false
  },

  "freshness": {
    "date_field": "biz_date",
    "lag_days": 0,
    "webhook": "https://open.feishu.cn/open-apis/bot/v2/hook/xxx"
  }
}
